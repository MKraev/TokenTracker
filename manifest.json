{
  "manifest_version": 3,
  "name": "My AI Token Tracker",
  "version": "1.2",
  "description": "Следи и експортира AI токени към моя GitHub Дашборд",
  "permissions": ["storage", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*", 
        "https://chatgpt.com/*", 
        "https://claude.ai/*", 
        "https://*.google.com/*"
      ],
      "js": ["utils.js", "dom-analyzer.js", "content.js"],
      "all_frames": true
    }
  ]
}